# Copy to .env and fill in. NEVER commit .env
TELEGRAM_BOT_TOKEN=

# The supergroup (with Topics enabled) where chats are mirrored.
# Run: python -m tools.discover_ids   to find this.
TELEGRAM_GROUP_ID=

# Your own Telegram user ID. The bot ignores everyone else.
TELEGRAM_OWNER_ID=

# Which projects to mirror. Either:
#   ALL                          every project Claude Code knows about
#   one folder                   just that one
#   several, separated by ;      a chosen few
# Send /projects in Telegram to see what is available.
WATCH_PROJECTS=ALL

# Let messages typed in Telegram run Claude on this PC. Set to false for a
# read-only mirror.
REPLIES_ENABLED=true

# What Claude may do without asking, when driven from Telegram:
#   manual          ask about nearly everything
#   acceptEdits     file edits yes, commands ask
#   auto            let Claude judge - same as the VS Code default
#   bypassPermissions  allow everything, never ask
CLAUDE_PERMISSION_MODE=auto

# How long to wait for you to tap Allow or Deny before refusing, in seconds.
APPROVAL_TIMEOUT=300

# Only needed if a second computer feeds the same Telegram group. The label
# goes in front of every topic name, e.g. "Laptop - MyApp: fix the login bug".
# Each machine also needs its own bot token - one token, one running copy.
MACHINE_LABEL=

# What /archive sends: md, html, or both.
#   md    plain and diff-friendly - the right thing to hand back to an AI
#   html  keeps formatting, collapses tool output, and reads correctly in
#         right-to-left languages, which Markdown cannot express
ARCHIVE_FORMAT=both

# Optional overrides. CLAUDE_CLI defaults to the claude.exe inside your
# VS Code extension, so you normally leave it blank.
CLAUDE_CLI=
CLAUDE_HOME=
POLL_INTERVAL=2.0
